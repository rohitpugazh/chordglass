{
  "name": "chordglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Real-time guitar chords, key and tuning for the song playing on Spotify, on Even Realities G2 glasses",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "evenhub-simulator http://127.0.0.1:5173/?demo",
    "qr": "evenhub qr --http --port 5173",
    "pack": "npm run build && node scripts/prepack.mjs && evenhub pack app.json dist -o chordglass.ehpk",
    "index:chordonomicon": "python -I scripts/build_chordonomicon_index.py"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
