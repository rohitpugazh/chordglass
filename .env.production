# Production builds (GitHub Pages and the packed .ehpk) load chords from the hosted index.
# `npm run dev` ignores this file and serves public/cn/ locally.
VITE_CHORD_INDEX_URL=https://rohitpugazh.github.io/chordglass/cn/
# ...and the chord-recognition model (ChordMini + onnxruntime wasm, ~32 MB).
VITE_MODEL_URL=https://rohitpugazh.github.io/chordglass/models/
